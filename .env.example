# Copy to .env (source checkout) or ~/.config/vector-toolbox/.env, or pass
# these as the `env` block of your MCP client config. Real environment
# variables always win over this file. Every value below is optional unless
# you use that backend.

# ---- Safety ----
# true = every write/delete tool refuses. Start here when exploring real data.
VTB_READ_ONLY=false

# ---- Backends ----
VTB_DEFAULT_BACKEND=pinecone

# Pinecone
PINECONE_API_KEY=
VTB_PINECONE_CLOUD=aws
VTB_PINECONE_REGION=us-east-1

# Chroma - the "default" client: ephemeral | persistent | http | cloud
VTB_CHROMA_CLIENT=persistent
VTB_CHROMA_PATH=~/.vector-toolbox/chroma
VTB_CHROMA_HOST=localhost
VTB_CHROMA_PORT=8000
VTB_CHROMA_SSL=false
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Weaviate - the "default" client: local | custom | cloud | embedded
VTB_WEAVIATE_CLIENT=local
VTB_WEAVIATE_HOST=localhost
VTB_WEAVIATE_PORT=8080
VTB_WEAVIATE_SECURE=false
VTB_WEAVIATE_GRPC_HOST=
VTB_WEAVIATE_GRPC_PORT=50051
VTB_WEAVIATE_GRPC_SECURE=
# Weaviate Cloud
WEAVIATE_URL=
WEAVIATE_API_KEY=
# Embedded Weaviate (the client downloads and runs the server)
VTB_WEAVIATE_EMBEDDED_PATH=~/.vector-toolbox/weaviate
VTB_WEAVIATE_EMBEDDED_VERSION=
# Keys for Weaviate's model modules are forwarded as headers when set:
# OPENAI_API_KEY, COHERE_API_KEY, VOYAGEAI_API_KEY, JINAAI_API_KEY,
# MISTRAL_API_KEY, ANTHROPIC_API_KEY, HUGGINGFACE_API_KEY, NVIDIA_API_KEY ...

# ---- Embeddings (pluggable) ----
# provider: pinecone | openai | cohere | huggingface
VTB_EMBED_PROVIDER=pinecone
VTB_EMBED_MODEL=llama-text-embed-v2
VTB_EMBED_DIMENSION=1024
VTB_SPARSE_PROVIDER=pinecone
VTB_SPARSE_MODEL=pinecone-sparse-english-v0
OPENAI_API_KEY=
COHERE_API_KEY=

# ---- Transport ----
# stdio (desktop clients launch the server) | http (run once, connect by URL)
VTB_TRANSPORT=stdio
VTB_HOST=127.0.0.1
VTB_PORT=8000
VTB_HTTP_PATH=/mcp
# When set, HTTP requests need "Authorization: Bearer <token>".
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
VTB_AUTH_TOKEN=
# Comma-separated Host headers to accept (DNS-rebinding protection), e.g.
# mcp.example.com,localhost:8000. Empty = no Host check (loopback binds get it automatically).
VTB_ALLOWED_HOSTS=
