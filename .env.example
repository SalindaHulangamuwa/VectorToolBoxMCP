# ---- Backend selection ----
VTB_DEFAULT_BACKEND=pinecone

# ---- Pinecone ----
PINECONE_API_KEY=pcsk_your_key_here
VTB_PINECONE_CLOUD=aws
VTB_PINECONE_REGION=us-east-1

# ---- Embeddings (pluggable providers) ----
# provider: pinecone | openai | cohere | huggingface
VTB_EMBED_PROVIDER=pinecone
VTB_EMBED_MODEL=text-embedding-3-large
VTB_EMBED_DIMENSION=3072

# sparse (optional, for hybrid / multi-signal indexes)
VTB_SPARSE_PROVIDER=pinecone
VTB_SPARSE_MODEL=pinecone-sparse-english-v0

OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=

# ---- Safety ----
# When true, every write/delete tool is disabled.
VTB_READ_ONLY=true
